def autocomplete_handler(text, state):
    options = [word for word in AUTOCOMPLETE_LIST if word.startswith(text.lower())]
    if state < len(options):
        return options[state]
    return None

def _is_process_running(image_name):
    try:
        result = subprocess.run(
            ["tasklist", "/FI", f"IMAGENAME eq {image_name}"],
            capture_output=True, text=True
        )
        return image_name.lower() in result.stdout.lower()
    except Exception:
        return False

def _run_powershell(script, timeout=15):
    try:
        result = subprocess.run(
            ["powershell", "-NoProfile", "-Command", script],
            capture_output=True, text=True, timeout=timeout
        )
        if result.returncode == 0:
            return result.stdout.strip()
    except Exception:
        pass
    return None

def _get_system_specs():
    ps_script = (
        "$os = Get-CimInstance Win32_OperatingSystem; "
        "$disk = Get-CimInstance Win32_LogicalDisk -Filter \"DeviceID='C:'\"; "
        "try { "
        "  $t = Get-CimInstance MSAcpi_ThermalZoneTemperature -Namespace 'root/wmi' "
        "-ErrorAction Stop | Select-Object -First 1 -ExpandProperty CurrentTemperature "
        "} catch { $t = 'NA' }; "
        "Write-Output \"$($os.TotalVisibleMemorySize)|$($os.FreePhysicalMemory)\"; "
        "Write-Output \"$($disk.Size)|$($disk.FreeSpace)\"; "
        "Write-Output $t"
    )

    output = _run_powershell(ps_script)
    if not output:
        return None

    lines = output.splitlines()
    if len(lines) < 3:
        return None

    try:
        total_kb, free_kb = (int(x) for x in lines[0].split("|"))
        disk_total_bytes, disk_free_bytes = (int(x) for x in lines[1].split("|"))
    except (ValueError, IndexError):
        return None

    ram_total_gb = total_kb / 1024 / 1024
    ram_used_gb = (total_kb - free_kb) / 1024 / 1024
    ram_percent = (ram_used_gb / ram_total_gb * 100) if ram_total_gb else 0

    disk_total_gb = disk_total_bytes / (1024 ** 3)
    disk_free_gb = disk_total_bytes - disk_free_bytes
    disk_percent = (disk_used_gb / disk_total_gb * 100) if disk_total_gb else 0

    cpu_temp_c = None
    temp_raw = lines[2].strip()
    if temp_raw and temp_raw != "NA":
        try:
            cpu_temp_c = (int(temp_raw) / 10) - 273.15
        except ValueError:
            cpu_temp_c = None

    return {
        "ram_used_gb": ram_used_gb,
        "ram_total_gb": ram_total_gb,
        "ram_percent": ram_percent,
        "disk_used_gb": disk_used_gb,
        "disk_total_gb": disk_total_gb,
        "disk_free_gb": disk_free_gb,
        "disk_percent": disk_percent,
        "cpu_temp_c": cpu_temp_c,
    }

def _spec_bar(percent, width=20):
    filled = int(round((percent / 100) * width))
    filled = max(0, min(width, filled))
    return "█" * filled + "░" * (width - filled)

def _print_specs(specs):
    if specs["cpu_temp_c"] is not None:
        temp_text = f"{specs['cpu_temp_c']:.1f}\u00b0C"
    else:
        temp_text = "N/A (sensor not exposed by this system)"

    ram_bar = _spec_bar(specs["ram_percent"])
    ram_text = (f"[{ram_bar}] {specs['ram_percent']:.0f}%  "
                f"({specs['ram_used_gb']:.1f}/{specs['ram_total_gb']:.1f} GB)")

    disk_bar = _spec_bar(specs["disk_percent"])
    disk_text = (f"[{disk_bar}] {specs['disk_percent']:.0f}%  "
                 f"({specs['disk_free_gb']:.1f} GB free of {specs['disk_total_gb']:.1f} GB)")

    rows = [
        f"{'CPU Temp':<9}: {temp_text}",
        f"{'RAM':<9}: {ram_text}",
        f"{'Storage':<9}: {disk_text}",
    ]

    title = "SYSTEM SPECS"
    width = max(max(len(r) for r in rows) + 2, len(title) + 4)

    pad = width - len(title) - 2
    left = pad // 2
    right = pad - left

    print()
    print("┌" + "─" * left + " " + title + " " + "─" * right + "┐")
    for row in rows:
        print("│ " + row.ljust(width - 2) + " │")
    print("└" + "─" * width + "┘")
    print()

def _has_spicetify():
