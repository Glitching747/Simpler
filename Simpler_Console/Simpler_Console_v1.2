def _detect_steam_game_misuse(tokens):
    """Returns (app_target, game_key) when a steam game is used without 'run steam'."""
    if len(tokens) < 2 or tokens[1].lower() == "steam":
        return None, None

    app = tokens[1].lower()

    if len(tokens) >= 3:
        remainder = " ".join(tokens[2:]).lower()
        if remainder in STEAM_GAMES:
            return app, remainder

    full_target = " ".join(tokens[1:]).lower()
    if full_target in STEAM_GAMES:
        return app, full_target

    return None, None

def _print_steam_game_misuse_warning(app_target):
