              "to have Spicetify, Simpler Console recommends you install Spicetify at "
              "https://spicetify.app/#install for a better Spotify experience!)")

def _check_statusgator(slug):
    """Best-effort scrape of a StatusGator status page. StatusGator has no
    stable public scrape API for these pages, and its markup can change at any
    time, so this returns one of "UP", "DOWN", "WARN", or None (couldn't tell)
    - never treat it as a guarantee, and the caller always shows the direct link."""
    url = f"https://statusgator.com/services/{slug}/"
    req = urllib.request.Request(
        url,
        headers={"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
                                "AppleWebKit/537.36 (KHTML, like Gecko) "
                                "Chrome/124.0 Safari/537.36"}
    )
    try:
        with urllib.request.urlopen(req, timeout=10) as response:
            html = response.read().decode("utf-8", errors="ignore")
    except urllib.error.HTTPError as e:
        if e.code == 404:
            return None, url, f"StatusGator has no page for '{slug}'."
        return None, url, f"StatusGator returned an error (HTTP {e.code})."
    except Exception as e:
        return None, url, f"Could not reach StatusGator ({e})."

    lowered = html.lower()

    # Primary status lives in an h3 heading like "YouTube is up".
    heading = re.search(
        r'<h3[^>]*>\s*[^<]*?\bis\s+(up|down|warn(?:ing)?|under\s+maintenance)\b',
        html,
        re.I,
    )
    if heading:
        status = heading.group(1).lower()
        if status == "up":
            return "UP", url, None
        if status == "down":
            return "DOWN", url, None
        if status.startswith("warn"):
            return "WARN", url, None
        if "maintenance" in status:
            return "MAINTENANCE", url, None

    if "currently operational" in lowered or "service was operational" in lowered:
        return "UP", url, None

    return None, url, "Couldn't confirm status from the page automatically."

_SPOTIFY_NOW_PLAYING_PS = r"""
Add-Type -AssemblyName System.Runtime.WindowsRuntime
$asTaskGeneric = ([System.WindowsRuntimeSystemExtensions].GetMethods() | Where-Object {
    $_.Name -eq 'AsTask' -and $_.GetParameters().Count -eq 1 -and
    $_.GetParameters()[0].ParameterType.Name -eq 'IAsyncOperation`1'
})[0]
function Await($WinRtTask, $ResultType) {
    $asTask = $asTaskGeneric.MakeGenericMethod($ResultType)
    $netTask = $asTask.Invoke($null, @($WinRtTask))
    $netTask.Wait(-1) | Out-Null
    $netTask.Result
}
[Windows.Media.Control.GlobalSystemMediaTransportControlsSessionManager,Windows.Media.Control,ContentType=WindowsRuntime] | Out-Null
$manager = Await ([Windows.Media.Control.GlobalSystemMediaTransportControlsSessionManager]::RequestAsync()) ([Windows.Media.Control.GlobalSystemMediaTransportControlsSessionManager])
$session = $null
foreach ($s in $manager.GetSessions()) {
    if ($s.SourceAppUserModelId -like '*Spotify*') { $session = $s; break }
}
if (-not $session) { Write-Output 'NO_SESSION'; exit 0 }
$playbackInfo = $session.GetPlaybackInfo()
$status = $playbackInfo.PlaybackStatus.ToString()
if ($status -eq 'Closed' -or $status -eq 'Stopped') {
    Write-Output 'STOPPED||'
    exit 0
}
$props = Await ($session.TryGetMediaPropertiesAsync()) ([Windows.Media.Control.GlobalSystemMediaTransportControlsSessionMediaProperties])
$title = if ($props.Title) { $props.Title } else { '' }
$artist = if ($props.Artist) { $props.Artist } else { '' }
$title = ($title -replace '[\r\n|]+', ' ').Trim()
$artist = ($artist -replace '[\r\n|]+', ' ').Trim()
Write-Output ($status + '|' + $title + '|' + $artist)
"""

def _get_spotify_now_playing():
    """Reads Spotify title/artist from Windows media controls.

    Returns one of:
      - ("playing"|"paused", title, artist)
      - ("stopped", "", "")
      - ("no_session", "", "") when Spotify has no active session
      - None on failure."""
    output = _run_powershell(_SPOTIFY_NOW_PLAYING_PS, timeout=8)
    if not output:
        return None

    line = output.splitlines()[-1].strip()
    if line == "NO_SESSION":
        return ("no_session", "", "")
    if line == "STOPPED||":
        return ("stopped", "", "")

    parts = line.split("|", 2)
    if len(parts) != 3:
        return None

    status, title, artist = parts
    status_key = status.lower()
    if status_key == "playing":
        return ("playing", title, artist)
    if status_key == "paused":
        return ("paused", title, artist)
    return ("stopped", title, artist)

def _format_spotify_track(state, title, artist):
    """Builds a single-line status message for the current Spotify track."""
    if state == "no_session":
        return "No Spotify playback session found."
    if state == "stopped":
        return "Spotify is not playing anything right now."
    if not title and not artist:
        return "Spotify is active, but no track info is available."

    label = "Now Playing" if state == "playing" else "Paused"
    if title and artist:
        return f"{label}: {title} — {artist}"
    if title:
        return f"{label}: {title}"
    return f"{label}: {artist}"

def _watch_spotify_now_playing():
    """Polls Spotify and prints track changes until Ctrl+C."""
    if not _is_process_running("Spotify.exe"):
        print("Spotify is not running. Start Spotify and try again.")
        return

    print("Watching Spotify now playing. Press Ctrl+C to stop.\n")
    last_message = None
    error_notified = False

    try:
        while True:
            track = _get_spotify_now_playing()
            if track is None:
                if not error_notified:
                    print("Could not read Spotify playback info from Windows media controls.")
                    error_notified = True
            else:
                error_notified = False
                state, title, artist = track
                message = _format_spotify_track(state, title, artist)
                if message != last_message:
                    print(message)
                    last_message = message

            time.sleep(1.5)
    except KeyboardInterrupt:
        print("\nStopped watching Spotify.")

def parse_and_execute(input_line):
    tokens = input_line.strip().split()
    if not tokens:
        return

    command_line = " ".join(tokens).lower()
    if command_line in SUPPORTED_LIST_OUTPUT:
        _print_supported_list(command_line)
        return

    # Extract the first word string out of the list before lowering it
    command = tokens[0].lower()

    # --- 1. RUN COMMAND ---
    if command == "run":
        if len(tokens) < 2:
            print("Syntax Error: Use 'run [app]' (e.g., run brave)")
            return
        
        raw_target = " ".join(tokens[1:]).lower()

        # Redirect if user tries old microsoft notepad
        if raw_target == "notepad":
            print('Please try "run notepad++", a better version of the Microsoft Notepad.')
            return

        # Detect a trailing "incognito" modifier and strip it off before
        # parsing the app name / site as usual, e.g. "run brave chatgpt incognito"
        incognito_requested = False
        if len(tokens) >= 3 and tokens[-1].lower() == "incognito":
            incognito_requested = True
            tokens = tokens[:-1]
            raw_target = " ".join(tokens[1:]).lower()

        misused_app, _misused_game = _detect_steam_game_misuse(tokens)
        if misused_app:
            _print_steam_game_misuse_warning(misused_app)
            return

        steam_game_id = None
        steam_game_name = None

        if len(tokens) >= 3 and tokens[1].lower() == "steam":
            steam_game_key = " ".join(tokens[2:]).lower()
            if steam_game_key in STEAM_GAMES:
                steam_game_id, steam_game_name = STEAM_GAMES[steam_game_key]
                target = "steam"
            else:
                print(f"Language Error: '{steam_game_key}' is not in the Steam game database. "
                      f"Options are: {', '.join(STEAM_GAMES)}")
                return

        # Some app names are more than one word - match those before
        # falling back to single-token app + optional site-argument parsing
        MULTI_WORD_APPS = {"system informer", "resource hacker"}

        site_urls = SITE_URLS

        # Only actual browsers know what to do with a site argument
        BROWSER_APPS = {"firefox", "chrome", "brave", "librewolf", "waterfox", "tor"}

        url_arg = ""
        brave_tor_requested = False

        if len(tokens) >= 3 and tokens[1].lower() == "brave" and tokens[2].lower() == "tor":
            brave_tor_requested = True
            target = "brave"
            remainder = [t.lower() for t in tokens[3:]]

            if incognito_requested:
                print("(Brave Tor doesn't currently support incognito.)")
                return

            if remainder:
                if len(remainder) > 1:
                    print("Syntax Error: Use 'run brave tor' with no extra arguments.")
                    return

                site_key = remainder[0]
                if site_key in site_urls:
                    print(TOR_SAFETY_MESSAGE)
                    return

                print(f"Language Error: '{site_key}' is not supported yet. "
                      f"Options are: {', '.join(site_urls)}")
                return

        elif raw_target in MULTI_WORD_APPS:
            target = raw_target

        elif steam_game_id is not None:
            pass

        else:
            # Extract target string correctly
            target = tokens[1].lower()

            # Shorthand: "run reddit" / "run x" with no app given -> default to Brave
            if target in site_urls:
                print("(Browser not specified, defaulting to Brave.)")
                url_arg = site_urls[target]
                target = "brave"

            elif len(tokens) >= 3 and target in BROWSER_APPS:
