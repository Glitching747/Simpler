                "exec": "Everything.exe",
                "id": "voidtools.Everything",
                "paths": [
                    r"C:\Program Files\Everything\Everything.exe",
                    r"C:\Program Files (x86)\Everything\Everything.exe",
                ]
            },
            "powertoys": {
                "exec": "PowerToys.exe",
                "id": "Microsoft.PowerToys",
                "paths": [
                    os.path.expandvars(r"%LOCALAPPDATA%\Microsoft\PowerToys\PowerToys.exe"),
                    os.path.expandvars(r"%LOCALAPPDATA%\Programs\PowerToys\PowerToys.exe"),
                    r"C:\Program Files\PowerToys\PowerToys.exe",
                ]
            },
            "rufus": {
                "exec": "rufus.exe",
                "id": "Rufus.Rufus",
                "paths": [
                    os.path.expandvars(r"%LOCALAPPDATA%\Microsoft\WinGet\Links\rufus.exe"),
                    os.path.expandvars(r"%LOCALAPPDATA%\Microsoft\WinGet\Packages\Rufus.Rufus_Microsoft.Winget.Source_8wekyb3d8bbwe\rufus.exe"),
                ]
            },
            "system informer": {
                "exec": "SystemInformer.exe",
                "id": "WinsiderSS.SystemInformer",
                "paths": [
                    r"C:\Program Files\SystemInformer\SystemInformer.exe",
                    os.path.expandvars(r"%LOCALAPPDATA%\Programs\SystemInformer\SystemInformer.exe")
                ]
            },
            "resource hacker": {
                "exec": "ResourceHacker.exe",
                "id": "AngusJohnson.ResourceHacker",
                "paths": [r"C:\Program Files\Resource Hacker\ResourceHacker.exe", r"C:\Program Files (x86)\Resource Hacker\ResourceHacker.exe"]
            },
            "windhawk": {
                "exec": "windhawk.exe",
                "id": "RamenSoftware.Windhawk",
                "paths": [r"C:\Program Files\Windhawk\windhawk.exe", os.path.expandvars(r"%LOCALAPPDATA%\Programs\Windhawk\windhawk.exe")]
            }
        }
        
        # FIXED: Corrected indentation alignment error out of dict body
        if target == "edge":
            print('(Simpler Console has noticed that you tried to run a chrome-installer, '
                  'you can simply just input "run chrome" or even better you could input "run brave".)')
            return

        if target not in app_database:
            print(f"Language Error: '{target}' is not supported yet.")
            return

        if steam_game_id is not None:
            print(f"Launching steam ({steam_game_name})...")
            try:
                webbrowser.open(f"steam://rungameid/{steam_game_id}")
            except Exception as e:
                print(f"Error launching Steam game: {e}")
            return

        incognito_flag = None
        if incognito_requested:
            if brave_tor_requested:
                print("(Brave Tor doesn't currently support incognito.)")
                return
            if INCOGNITO_FLAGS.get(target):
                incognito_flag = INCOGNITO_FLAGS[target]
            else:
                print(f"({target.title()} doesn't currently support incognito.)")
                return

        app_info = app_database[target]
        launch_path = None

        # 1. Look for global path mapping
        system_lookup = shutil.which(app_info["exec"])
        if system_lookup:
            launch_path = system_lookup
        else:
            # 2. Look through hardcoded directory mappings
            for path in app_info["paths"]:
                if path and os.path.exists(path):
                    launch_path = path
                    break

        # 3. If missing everywhere, trigger Winget download
        if not launch_path:
            print(f"'{target}' not found. Downloading securely via Winget...")
            install_proc = subprocess.run(["winget", "install", "--id", app_info["id"], "--silent", "--accept-source-agreements", "--accept-package-agreements"])
            
            # Re-scan paths immediately after installation completes
            for path in app_info["paths"]:
                if path and os.path.exists(path):
                    launch_path = path
                    break
            
            if not launch_path:
                launch_path = app_info["exec"]

        # Custom Mod: Messages
        if target == "spotify":
            _print_spotify_notice()

        # Discord launches via its Update.exe with a --processStart flag
        if target == "discord" and launch_path and launch_path.lower().endswith("update.exe"):
            final_command = f'Start-Process "{launch_path}" -ArgumentList "--processStart Discord.exe"'
            print(f"Launching {target}...")
            try:
                subprocess.Popen(["powershell", "-Command", final_command], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception as e:
                print(f"Error executing application launcher: {e}")
            return

        # Explicitly format strings so PowerShell handles spaces in paths without tripping
        launch_args = []
        if brave_tor_requested:
            launch_args.append("--tor")
        elif incognito_flag:
            launch_args.append(incognito_flag)
        if url_arg:
            launch_args.append(url_arg)

        final_command = f'Start-Process "{launch_path}"'
        if launch_args:
            quoted_args = ",".join(f'"{a}"' for a in launch_args)
            final_command = f'Start-Process "{launch_path}" -ArgumentList {quoted_args}'

        display_name = "brave tor" if brave_tor_requested else target
        print(f"Launching {display_name}...")
        try:
            subprocess.Popen(["powershell", "-Command", final_command], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception as e:
            print(f"Error executing application launcher: {e}")

    # --- 2. KILL COMMAND ---
    elif command == "kill":
        if len(tokens) < 2:
            print("Syntax Error: Use 'kill [app]' (e.g., kill spotify)")
            return

        target = " ".join(tokens[1:]).lower()
        if target not in PROCESS_NAMES:
            print(f"Language Error: '{target}' is not supported yet.")
            return

        image_name = PROCESS_NAMES[target]
        print(f"Terminating {target}...")
        try:
            result = subprocess.run(
                ["taskkill", "/IM", image_name, "/F"],
                capture_output=True, text=True
            )
            # taskkill can report success (returncode 0) even when one of
            # several matching processes survives (commonly because it's
            # running elevated and this console isn't) - so re-check reality
            # with tasklist rather than trusting the returncode alone.
            still_running = _is_process_running(image_name)

            if result.returncode == 0 and not still_running:
                print(f"{target} terminated.")
            elif still_running:
                print(f"{target} is still running - it may be running with "
                      f"administrator privileges. Try re-running Simpler "
                      f"Console as Administrator and killing it again.")
            else:
                print(f"{target} does not appear to be running.")
        except Exception as e:
            print(f"Error terminating application: {e}")

    # --- 3. STATUS COMMAND ---
    elif command == "status":
        # No argument: report on every supported app
        if len(tokens) < 2:
            print("\n=== Application Status ===")
            checked = set()
            for app, image_name in PROCESS_NAMES.items():
                if image_name in checked:
                    continue
                checked.add(image_name)
                running = _is_process_running(image_name)
                state = "RUNNING" if running else "not running"
                print(f"  {app:<12} -> {state}")
            print()
            return

        target = " ".join(tokens[1:]).lower()
        if target not in PROCESS_NAMES:
            print(f"Language Error: '{target}' is not supported yet.")
            return

        image_name = PROCESS_NAMES[target]
        running = _is_process_running(image_name)
        state = "is currently RUNNING" if running else "is not running"
        print(f"{target} {state}.")

    # --- 4. SPECS COMMAND ---
    elif command == "specs":
        specs = _get_system_specs()
        if specs is None:
            print("Could not retrieve system specs (PowerShell may be "
                  "unavailable, or this isn't running on Windows).")
            return
        _print_specs(specs)

    # --- 5. PING COMMAND ---
    elif command == "ping":
        if len(tokens) < 2:
            print("Syntax Error: Use 'ping [site]' (e.g., ping reddit)")
            return

        site_key = tokens[1].lower()
        if site_key not in SITE_URLS:
            print(f"Language Error: '{site_key}' is not supported yet. "
                  f"Options are: {', '.join(SITE_URLS)}")
            return

        slug = STATUSGATOR_SLUGS[site_key]
        print(f"Checking StatusGator for {site_key}...")
        state, url, error = _check_statusgator(slug)

        if state == "UP":
            print(f"{site_key} looks UP - no problems currently reported.")
        elif state == "DOWN":
            print(f"{site_key} may be DOWN - other users are reporting problems.")
        elif state == "WARN":
            print(f"{site_key} may have ISSUES - degraded performance or partial outage reported.")
        elif state == "MAINTENANCE":
            print(f"{site_key} is under MAINTENANCE - scheduled work may affect availability.")
        else:
            print(f"Couldn't automatically confirm {site_key}'s status. {error or ''}".strip())

        print(f"Source: {url}")

    # --- 6. SPOTIFY NOW PLAYING ---
    elif command == "spotnowplaying":
        _watch_spotify_now_playing()

    # --- 7. ISSUE DIAGNOSTIC SYSTEM ---
    elif command == "issue":
        if len(tokens) < 2:
            print("Syntax Error: Use 'issue [run]'")
            return
        
        # FIXED: Finished truncated token parse line safely
        sub_command = tokens[1].lower()
        
        if sub_command == "run":
            print("(Please make sure you have everything in your Program Files!)")
        else:
            print(f"Unknown parameter: 'issue {sub_command}'. Options are: run")

    # --- 8. CLEAR COMMAND ---
    elif command == "clear":
        print_banner()

    # --- 9. HELP MENU ---
    elif command == "help":
        print("\n=== Simpler Console App Controller ===")
        print("Available Commands:")
        print("  run [app] [optional_site] -> Launches supported browsers, apps, or links.")
        print("  kill [app]                -> Force-closes a running app.")
        print("  status [app]              -> Shows whether one or all apps are running.")
        print("  specs                     -> Shows CPU temp, RAM, and storage usage.")
        print("  ping [site]               -> Checks StatusGator for a site's status.")
        print("  run steam [game]          -> Launches a game from the Steam game database.")
        print("  run brave tor             -> Launches Brave in a private Tor window.")
        print("  spotnowplaying            -> Shows Spotify track info and updates on change.")
        print("  supported [?]             -> Lists supported browsers, apps, websites, or Steam games.")
        print("  issue [topic]             -> Prints a helpful reminder.")
        print("  clear                     -> Clears the console, keeping the banner.")
        print("  help                      -> Displays this menu.")
        print("  exit                      -> Closes the console app.\n")

    # --- 10. EXIT APPLICATION ---
    elif command == "exit":
        print("Exiting Simpler Console. Goodbye!")
        sys.exit(0)

    else:
        print(f"Unknown Command: '{command}'. Type 'help' for options.")

def print_banner():
    """Clears the screen and prints the logo, tagline, and help hint."""
    os.system('cls' if os.name == 'nt' else 'clear')

    print(r"  ____ ___ __  __ ____  _     _____ ____     ____ ___  _   _ ____   ___  _     _____ ")
    print(r" / ___|_ _|  \/  |  _ \| |   | ____|  _ \   / ___/ _ \| \ | / ___| / _ \| |   | ____|")
    print(r" \___ \| || |\/| | |_) | |   |  _| | |_) | | |  | | | |  \| \___ \| | | | |   |  _|  ")
    print(r"  ___) | || |  | |  __/| |___| |___|  _ <  | |__| |_| | |\  |___) | |_| | |___| |___ ")
    print(r" |____/___|_|  |_|_|   |_____|_____|_| \_\  \____\___/|_| \_|____/ \___/|_____|_____|")
    print("\n                    \"DO IT SIMPLER, DO IT BETTER\"                  ")
    print("======================================================================================")
    print("Type 'help' for basic syntax instructions.\n")

def main():
    print_banner()

    if readline:
        readline.parse_and_bind("tab: complete")
        readline.set_completer(autocomplete_handler)

    while True:
        try:
            user_input = input("simpler //> ")
            parse_and_execute(user_input)
        except (KeyboardInterrupt, EOFError):
            print("\nExiting.")
            break

if __name__ == "__main__":
    main()
