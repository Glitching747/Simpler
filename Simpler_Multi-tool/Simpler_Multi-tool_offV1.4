def parse_targets(target):
    ips = []
    
    try:
        if "/" in target:
            network = ipaddress.ip_network(target, strict=False)
            ips = [str(ip) for ip in network.hosts()]
        elif "-" in target:
            parts = target.split("-")
            start = ipaddress.ip_address(parts[0].strip())
            end = ipaddress.ip_address(parts[1].strip())
            current = start
            while current <= end:
                ips.append(str(current))
                current += ipaddress.ip_address(1)
        elif "," in target:
            ips = [ip.strip() for ip in target.split(",")]
        else:
            ips = [target]
    except:
        pass
    
    return ips


def rev_dns_lookup(ip):
    try:
        hostname = socket.gethostbyaddr(ip)
        return {
            "ip": ip,
            "hostname": hostname[0],
            "aliases": hostname[1]
        }
    except socket.herror:
        return None
    except:
        return None


def classify_host(hostname, results):
    hostname_lower = hostname.lower()
    
    entry = {"ip": "unknown", "hostname": hostname}
    
    # Server patterns
    if any(x in hostname_lower for x in ["server", "web", "www", "http", "mail", "smtp", "ftp", "dns", "proxy", "cdn"]):
        results["hostname_types"]["servers"].append(entry)
    # Cloud patterns
    elif any(x in hostname_lower for x in ["aws", "azure", "google", "cloud", "amazon", "ec2", "s3", "gcp", "heroku"]):
        results["hostname_types"]["cloud"].append(entry)
    # IoT patterns
    elif any(x in hostname_lower for x in ["cam", "nvr", "dvr", "iot", "sensor", "thermostat", "hub"]):
        results["hostname_types"]["iot"].append(entry)
    # Network patterns
    elif any(x in hostname_lower for x in ["router", "switch", "gateway", "firewall", "ap", "wifi", "lan"]):
        results["hostname_types"]["network"].append(entry)
    # Device patterns
    elif any(x in hostname_lower for x in ["pc", "laptop", "desktop", "mobile", "phone", "tablet", "device", "host"]):
        results["hostname_types"]["devices"].append(entry)
    else:
        results["hostname_types"]["unknown"].append(entry)
    
    results["active_hosts"].append(entry)
    
