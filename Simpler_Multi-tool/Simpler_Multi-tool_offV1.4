# 3. Intercept all text to make it green
class GreenStream:
    def __init__(self, original_stream):
        self.stream = original_stream

    def write(self, data):
        if data.strip():  
            self.stream.write(f"\033[32m{data}\033[0m")
        else:
            self.stream.write(data)

    def flush(self):
        self.stream.flush()

sys.stdout = GreenStream(sys.stdout)
sys.stderr = GreenStream(sys.stderr)

