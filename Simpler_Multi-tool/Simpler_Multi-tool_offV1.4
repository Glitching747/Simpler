def ip_checker():
    try:
        # 1. User Input
        target_ip = input("Enter the IP Address to check:").strip()
        
        if not target_ip:
            print("\033[92m[Error] No IP address provided.")
            return

        # 2. API Call Setup
        # Using ip-api.com which supports free access without an API key for standard usage.
        api_url = f"http://ip-api.com/json/{target_ip}"
        
        print("\n[Processing] Connecting to global database...")
        time.sleep(1)
        
        with urllib.request.urlopen(api_url, timeout=10) as response:
            data = json.loads(response.read().decode())

        # 3. Validation Check from API
        if not data.get('status') == 'success':
            print("\n[Error] Unable to locate IP address or invalid format.")
            return
            
    except urllib.error.URLError as e:
        print(f"\n[Network Error] {e.reason}")
        print("Please check your internet connection and try again.")
        return
    except Exception as e:
        print(f"\n[System Error] {str(e)}")
        return

    # 4. Display Information
    print("\n" + "="*50)
    print(f"       IP REPORT FOR: {target_ip}")
    print("="*50)
    
    info = [
        ("Country", data.get('country', 'N/A')),
        ("Region Name", data.get('regionName', 'N/A')),
        ("City", data.get('city', 'N/A')),
        ("Latitude/Longitude", f"{data.get('lat')} / {data.get('lon')}"),
        ("ISP", data.get('isp', 'N/A')),
        ("Organization", data.get('org', 'N/A')),
        ("Timezone", data.get('timezone', 'N/A')),
        ("Locale", data.get('as', 'N/A')),
        ("Postal Code", data.get('zip', 'N/A')),
    ]

    for label, value in info:
        print(f"  {label:<20} : {value}")
        
    input("\033[92mScan Complete. Press Enter to return to the main menu...\033[0m")
    # RE-LOCK TEXT COLOR TO GREEN BEFORE MOVING BACK TO THE MENU SHOWTIME
    print("\033[92m", end="")

# ==========================================
# EMAIL CHECKER LOGIC
# ==========================================
def email_checker():
    """
    Validates an email address and provides structural information 
    regarding its format and domain composition.
    """
    
    print("\n" + "="*50)
    print("\033[92m          EMAIL VALIDATION & ANALYSIS")
    print("="*50 + "\n")

    # Prompt as requested
    user_email = input("\033[92mEnter the Email Address to check: \033[0m").strip()

    if not user_email:
        print("\033[92m[Error] Input cannot be empty.")
        return

    # Regex pattern for email validation
    email_pattern = re.compile(
        r"^[a-zA-Z0-9_.+-]+"      # Local part
        "@"                       # @ symbol
        "[a-zA-Z0-9-]+"           # Domain name
        "\."                      # Dot separator
        "[a-zA-Z]{2,}$"           # Top-level domain (TLD)
    )

    print(f"\n\033[92m[Processing] Analyzing {user_email}...")
    time.sleep(1)

    match = re.match(email_pattern, user_email)

    # Separate local and domain parts
    if "@" in user_email:
        username_part, domain_part = user_email.split("@", 1)
    else:
        username_part = ""
        domain_part = ""

    print("\n" + "-"*50)
    print("\033[92mANALYSIS REPORT")
    print("-"*50)

    # 1. Format Validation
    if match:
        status_msg = "\033[92mVALID\033[0m" # Green color code
        status_desc = "Format adheres to standard RFC syntax."
    else:
        status_msg = "\033[91mINVALID\033[0m" # Red color code
        status_desc = "Syntax errors detected (e.g., missing @ or invalid characters)."

    print(f"\nValidation Status : {status_msg}")
    print(f"\033[92mDescription       : {status_desc}")

    # 2. Component Details
    if match:
        print(f"\033[92m\nLocal Part      : @{username_part}")
        print(f"\033[92mDomain          : .{domain_part}")
        
        # Analyze TLD and Provider hints
        tld = domain_part.split('.')[-1] if "." in domain_part else "N/A"
        print(f"TLD             : {tld.upper()}")

        # Simulate DNS/MX Check Info (Informational)
        print("\n[Network Information]")
        try:
            host_info = socket.gethostbyname(domain_part)
            print(f"\033[92mDNS Resolved  : True ({host_info})")
            mx_record_status = "[Configured]"
        except socket.gaierror:
            print("\033[92mDNS Resolved  : False (Domain unreachable)")
            mx_record_status = "[Check DNS Configuration]"
        
        print(f"\033[92mMX Record Status: {mx_record_status}")

    print("-"*50)
    print("[Analysis Complete]")
        # CRITICAL FIX: Pauses the application window so results remain visible
    input("\033[92mScan Complete. Press Enter to return to the main menu...\033[0m")
    # RE-LOCK TEXT COLOR TO GREEN BEFORE MOVING BACK TO THE MENU SHOWTIME
    print("\033[92m", end="")
    
# ==========================================
# IMAGE METADATA DELETER LOGIC
# ==========================================
def image_metadata_deleter():
    # Get the file path from the user
    user_input = input("\033[92mInput the image file path to extract metadata:")
    
    # Clean up Windows quotes if the path was copied directly
    file_path = user_input.strip('"')
    
    try:
        # 1. Open and read the data first
        with Image.open(file_path) as img:
            img_format = img.format
            
            print("\n--- Current Metadata ---")
            print(f"\033[92mFormat: {img_format}")
            print(f"\033[92mSize: {img.size}")
            
            exif_data = img.getexif()
            if exif_data:
                for tag_id, value in exif_data.items():
                    tag_name = TAGS.get(tag_id, tag_id)
                    print(f"\033[92m{tag_name}: {value}")
            else:
                print("\033[92mNo EXIF metadata found.")

            # Load image data into memory so we can safely overwrite the file
            img.load()

        # 2. Overwrite the file with a clean copy (removes metadata)
        print("\n\033[92mDeleting metadata from the source file...")
        
        # Saving without passing the 'exif' parameter strips it completely
        img_clean = Image.frombytes(img.mode, img.size, img.tobytes())
        img_clean.save(file_path, format=img_format)
        
        print("\033[92mMetadata successfully deleted!")
                
    except FileNotFoundError:
        print("\033[92mError: The specified file could not be found.")
    except Exception as e:
        print(f"\033[92mError handling image: {e}")
        
    # Wait for user input before continuing back to your menu
    print("\n\033[92m")
    input("\033[92mPress Enter to return to the main menu...")
    print("\033[92m", end="")
    
