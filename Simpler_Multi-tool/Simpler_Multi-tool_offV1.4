def temp_mail_generator():
    # We use a Session object so Python automatically remembers our inbox cookie/token
    session = requests.Session()

    # 1. Provide an extensive set of browser headers to perfectly match a real Chrome user
    session.headers.update({
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
        "Accept": "application/json, text/javascript, */*; q=0.01",
        "Accept-Language": "en-US,en;q=0.9",
        "X-Requested-With": "XMLHttpRequest"
    })

    print("\n[*] Connecting to Guerrilla Mail infrastructure...")

    # 2. Hit the main index endpoint FIRST to accept cookies/session tokens like a browser does
    try:
        session.get("https://guerrillamail.com", timeout=10)

        # ###############################################################
        # FIX: Changed URL to point to the actual ajax JSON endpoint
        # ###############################################################
        init_url = "https://guerrillamail.com/ajax.php?f=get_email_address"
        response = session.get(init_url, timeout=10)
        
        # Safe check to see if we got HTML (blocked/Cloudflare) instead of JSON
        if "application/json" not in response.headers.get("Content-Type", ""):
            print("[-] Guerrilla Mail is blocking the automated request via Cloudflare.")
            print("[-] Please generate one manually in your browser instead.")
            input("Press Enter to return to main menu...")
            return

        init_data = response.json()
        email_address = init_data.get("email_addr")
        seq = 0

        print(f"\033[92m[+] Generated Guerrilla Mail: {email_address}\033[0m")
        print("\033[92m[*] Listening for incoming emails... (Press Ctrl+C to stop listening)\n")

    except Exception as e:
        print(f"[-] Failed to establish a session with Guerrilla Mail: {e}")
        print("\n" + "=" * 50)
        input("Press Enter to return to main menu...")
        return

    # 4. Poll the inbox continuously
    try:
        while True:
            # FIX: Updated URLs to hit the real ajax.php endpoint for fetching messages
            check_url = f"https://guerrillamail.com/ajax.php?f=check_email&seq={seq}"
            response = session.get(check_url)
            
            if "application/json" not in response.headers.get("Content-Type", ""):
                time.sleep(5)
                continue
                
            init_data = response.json()
            list_emails = init_data.get("list", [])

            if list_emails:
                for email in list_emails:
                    print("-" * 50)
                    print(f"\033[92mFrom: {email.get('mail_from')}\033[0m")
                    print(f"\033[92mSubject: {email.get('mail_subject')}\033[0m")

                    # FIX: Updated endpoint to fetch message body correctly
                    mail_id = email.get("mail_id")
                    fetch_url = f"https://guerrillamail.com/ajax.php?f=fetch_email&email_id={mail_id}"
                    body_response = session.get(fetch_url)
                    
                    if "application/json" in body_response.headers.get("Content-Type", ""):
                        email_body_data = body_response.json()
                        print(f"\033[92mMessage: {email_body_data.get('mail_body')}\033[0m")
                    print("-" * 50)

            # Update the sequence token to avoid re-reading old messages
            if init_data.get("sid"):
                # Real API keeps track using the 'sid' and returning seq increments
                seq = init_data.get("seq", seq)

            time.sleep(5) # Refresh every 5 seconds

    except KeyboardInterrupt:
        print("\n\n\033[92m[-] Stopped listening for emails.\033[0m")

    # 5. Halt until the user hits enter
    print("\n" + "=" * 50)
    input("\033[92mPress Enter to return to main menu...\033[0m")
    print("\033[92m", end="")
    
# ==========================================
# FILE HASHER LOGIC
# ==========================================
def file_hasher():    
    print("\033[92m\n" + "=" * 50)
    print("[+] File Integrity Hasher")
    print("=" * 50 + "\033[0m")

    
    # 1. Ask the user for the target file path
    # Example: C:\Users\Username\Downloads\test.exe
    file_path = input("\n\033[92mEnter the full path to the file:").strip().strip('"')

    # 2. Check if the file actually exists before wasting resources
    if not os.path.exists(file_path):
        print("\033[91m[-] Error: The specified file path does not exist.\033[0m")
        print("\n" + "=" * 50)
        input("\033[92mPress Enter to return to main menu...\033[0m")
        return

    # Check if it's a directory instead of a file
    if os.path.isdir(file_path):
        print("\033[91m[-] Error: That is a folder, not a single file.\033[0m")
        print("\n" + "=" * 50)
        input("\033[92mPress Enter to return to main menu...\033[0m")
        return

    print("\n[*] Processing binary data stream... Please wait...")

    # 3. Initialize the cryptographic engines
    md5_hasher = hashlib.md5()
    sha256_hasher = hashlib.sha256()

    try:
        # Open the file in Read-Binary ('rb') mode
        with open(file_path, 'rb') as file:
            while True:
                # Read file in optimized 64KB chunks to keep RAM clear
                chunk = file.read(65536)
                if not chunk:
                    break
                # Feed the data block into both algorithms simultaneously
                md5_hasher.update(chunk)
                sha256_hasher.update(chunk)

        # 4. Extract and print the final hexadecimal signatures
        print("\n" + "-" * 50)
        print(f"\033[92mMD5 Hash    : {md5_hasher.hexdigest()}\033[0m")
        print(f"\033[92mSHA-256 Hash: {sha256_hasher.hexdigest()}\033[0m")
        print("\033[92m-" * 50)

    except Exception as e:
        print(f"\033[91m[-] Read Error occurred: {e}\033[0m")

    # 5. Return sequence
    print("\n" + "=" * 50)
    input("\033[92mPress Enter to return to main menu...\033[0m")
    print("\033[92m", end="")

