# PASSWORD GENERATOR LOGIC
# ==========================================
def password_generator():
    # Define the character pool: Letters (upper & lower), digits, and symbols
    character_pool = string.ascii_letters + string.digits + string.punctuation

    print("--- Secure Password Generator ---")
    print("Select a password strength option:")
    print("[1]: 8 ch random password (Medium Entropy Status)")
    print("[2]: 12 ch random password (Strong Entropy Status)")
    print("[3]: 19 ch random password (Excellent Entropy Status)")
    print("[4]: 32 ch random password (OVERKILL Entropy Status)")

    # Mapping user choice to the requested character lengths
    length_mapping = {"1": 8, "2": 12, "3": 19, "4": 32}

    user_choice = input("\nEnter your choice (1-4): ").strip()

    if user_choice in length_mapping:
        target_length = length_mapping[user_choice]

        # Securely generate the password character by character from the pool
        password = "".join(
            secrets.choice(character_pool) for _ in range(target_length)
        )

        print(f"\nGenerated Password: {password}")
    else:
        print("\nInvalid selection. Please choose 1-4.")

    # Pause execution until the user presses Enter to return to your main menu logic
    input("\nPress Enter to return to main menu...")

# ==========================================
# PORT SCANNER LOGIC
# ==========================================
def port_scanner():
    # 1. Gather User Input
    target = input("Enter target host (IP or Domain): ").strip()
    if not target:
        print("[-] Invalid target.")
        input("\nPress Enter to return to main menu...")
        return

    try:
        target_ip = socket.gethostbyname(target)
    except socket.gaierror:
        print("\n[-] Hostname could not be resolved.")
        input("\nPress Enter to return to main menu...")
        return

    print(f"\n[*] Scanning Target: {target} ({target_ip})")
    print(f"[*] Scan Started at: {str(datetime.now())}")
    print("[*] Checking common ports (this may take a moment)...\n")
    print(f"{'PORT':<10}{'STATE':<10}{'SERVICE':<15}{'COMMON USAGE & INFO'}")
    print("-" * 75)

    # 2. Define standard target ports and descriptions
    common_ports = {
        21: ("FTP", "File Transfer Protocol - Used for transferring files. Often insecure."),
        22: ("SSH", "Secure Shell - Secure remote command-line access and file transfers."),
        23: ("Telnet", "Telnet - Unencrypted remote text communication. Highly vulnerable."),
        25: ("SMTP", "Simple Mail Transfer Protocol - Used for routing/sending emails."),
        53: ("DNS", "Domain Name System - Translates domain names into IP addresses."),
        80: ("HTTP", "Hypertext Transfer Protocol - Standard unencrypted web traffic."),
        110: ("POP3", "Post Office Protocol v3 - Used by email clients to retrieve emails."),
        139: ("NetBIOS", "NetBIOS - File and printer sharing over a local network connection."),
        143: ("IMAP", "Internet Message Access Protocol - Modern protocol for email retrieval."),
        443: ("HTTPS", "HTTP Secure - Encrypted web traffic using SSL/TLS certificates."),
        445: ("SMB", "Server Message Block - Windows file sharing. Targets of EternalBlue exploits."),
        1433: ("MSSQL", "Microsoft SQL Server - Database management network traffic."),
        3306: ("MySQL", "MySQL Database - Very common database connector endpoint."),
        3389: ("RDP", "Remote Desktop Protocol - Windows remote graphical desktop access."),
        8080: ("HTTP-Alt", "HTTP Alternate - Commonly used for web proxies or dev web servers.")
    }

    open_ports_count = 0

    # 3. Execution of the network scan loop
    try:
        for port, info in common_ports.items():
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.settimeout(0.8)
            
            result = s.connect_ex((target_ip, port))
            
            if result == 0:
                print(f"{port:<10}{'OPEN':<10}{info[0]:<15}{info[1]}")
                open_ports_count += 1
                
            s.close()

        if open_ports_count == 0:
            print("\n[-] Scan complete. No common open ports were detected on this target.")
        else:
            print(f"\n[+] Scan complete. Found {open_ports_count} open port(s).")

    except KeyboardInterrupt:
        print("\n[-] Scan cancelled by user.")
    except socket.error:
        print("\n[-] Could not connect to server framework host.")

    # 4. Enforced Return to Main Menu Control Block
    input("\nPress Enter to return to main menu...")

