# USERNAME CHECKER LOGIC
# ==========================================
def username_checker():
    """Simulates checking a username across multiple social media platforms."""
    username = input("\033[92mEnter the Username to Check: \033[0m").strip()
    
    if not username:
        print("\033[91m[ERROR] Username cannot be empty.")
        return

    print(f"\n\033[92mSearching for '@{username}' across social platforms...\033[0m\n")

    # List of platforms we will check
    platforms = [
        {"name": "Instagram", "url_template": "https://instagram.com/{}", "time": 0.8},
        {"name": "YouTube", "url_template": "https://youtube.com/@{}", "time": 0.8},
        {"name": "Reddit", "url_template": "https://reddit.com/{}", "time": 1.2},
        {"name": "Twitch", "url_template": "https://twitch.tv/{}", "time": 1.2},
        {"name": "Twitter (X)", "url_template": "https://x.com/{}", "time": 1.2},
        {"name": "GitHub", "url_template": "https://github.com/{}", "time": 0.6},
        {"name": "LinkedIn", "url_template": "https://linkedin.com/in/{}", "time": 1.5},
        {"name": "TikTok", "url_template": "https://tiktok.com/@{}", "time": 0.9}
    ]

    results = []

    # Simulate Network Request Processing
    for platform in platforms:
        print(f"\033[92mChecking {platform['name']}...\033[0m")
        time.sleep(platform['time'])
        
        # Generate the actual target URL
        target_url = platform['url_template'].format(username)
        
        try:
            # Send a real web request to check the page
            response = requests.get(target_url, timeout=5, headers={"User-Agent": "Mozilla/5.0"})
            
            # If the page loads successfully (Status 200), the user exists
            if response.status_code == 200:
                status = "[EXISTS]"
                color_code = "\033[92m"  # Green
            # If the page gives a 404 error, the username is available
            elif response.status_code == 404:
                status = "[AVAILABLE]"
                color_code = "\033[91m"  # Red
            else:
                status = f"[UNKNOWN ({response.status_code})]"
                color_code = "\033[93m"  # Yellow
                
        except requests.exceptions.RequestException as e:
            print(f"\033[93m[DEBUG] System Error: {e}\033[0m") # Add this line to see the actual error
            status = "[ERROR]"
            color_code = "\033[91m"  # Red


        # Crucial: Use 'platform' here because it belongs to the loop above
        results.append({
            "platform": platform['name'],
            "status": status,
            "url": target_url,
            "color": color_code
        })

    # Generate Report
    print("\n\033[92m" + "="*60)
    print(f"\033[92mREPORT FOR USER: @{username}")
    print("="*60)

    # Crucial: Use 'r' here because it belongs to the display loop below
    for r in results:
        print(f"{r['color']}{r['platform']}: {r['status']}\033[0m")
        print(f"\033[92m  URL: {r['url']}")

    # Summary Calculations
    taken_count = sum(1 for r in results if r['status'] == "[EXISTS]")
    available_count = len(results) - taken_count

    print("\n" + "="*60)
    print("\033[92mSUMMARY:\033[0m")
    print(f"\033[92m  Profiles Found : {taken_count}")
    print(f"\033[92m  Names Available: {available_count}")
    print("="*60)

    # Pauses the application window so results remain visible
    input("\n\033[92mScan Complete. Press Enter to return to the main menu...\033[0m")
    print("\033[92m", end="")

