# Best-effort winget package IDs used for auto-install when a browser isn't
# found. Some of these (Zen, Helium, I2P especially) vary by publisher/version
# on winget — if one fails to resolve, run `winget search <name>` yourself
# to find the right --id and update this dict.
WINGET_IDS = {
    "Chrome": "Google.Chrome",
    "Brave": "Brave.Brave",
    "Firefox": "Mozilla.Firefox",
    "LibreWolf": "LibreWolf.LibreWolf",
    "Waterfox": "Waterfox.Waterfox",
    "Tor Browser": "TorProject.TorBrowser",
    "Zen": "Zen-Team.Zen-Browser",
    "Ungoogled Chromium": "eloston.ungoogled-chromium",
    "Helium": "net.imput.Helium",
    "I2P": "i2pd.i2pd",
}
 
 
def winget_available():
    return platform.system() == "Windows" and shutil.which("winget") is not None
 
 
def install_via_winget(name: str):
    """Blocking call — run this on a background thread, not the GUI thread.
    Returns (success: bool, message: str)."""
    pkg_id = WINGET_IDS.get(name)
    if not pkg_id:
        return False, f"No winget package ID known for {name}."
    try:
        result = subprocess.run(
            [
                "winget", "install", "--id", pkg_id, "-e",
                "--accept-package-agreements", "--accept-source-agreements",
                "--silent",
            ],
            capture_output=True, text=True, timeout=900,
        )
        if result.returncode == 0:
            return True, f"{name} installed successfully."
        return False, (result.stderr or result.stdout or "winget install failed").strip()[-500:]
    except FileNotFoundError:
        return False, "winget isn't available on this system."
    except subprocess.TimeoutExpired:
        return False, f"Installing {name} via winget timed out."
    except Exception as exc:
        return False, str(exc)
 
 
def find_browser_path(name: str):
    """Try to locate an installed browser's executable. Returns a path/command
    or None if it can't be found."""
    info = BROWSER_DEFS[name]
    system = platform.system()
 
    # 1. Check PATH via shutil.which for every known command alias
    for cmd in info["which"]:
        found = shutil.which(cmd)
        if found:
            return found
 
    # 2. Check common install locations per OS
    if system == "Windows":
        for path in info.get("win_paths", []):
            if os.path.isfile(path):
                return path
    elif system == "Darwin":
        for path in info.get("mac_paths", []):
            if os.path.isfile(path):
                return path
 
    return None
 
 
def build_command(name: str, url: str, incognito: bool, tor: bool = False):
    """Build the subprocess command list for launching `name` at `url`.
 
    `tor` only applies to Brave: it opens a new private window that routes
    through the Tor network (Brave's built-in "New Private Window with Tor").
    """
    path = find_browser_path(name)
    if not path:
        return None
 
    engine = BROWSER_DEFS[name]["engine"]
    cmd = [path]
 
    if tor and name == "Brave":
        # Brave's private-window-with-Tor mode; this is private on its own,
        # so we don't also add --incognito.
        cmd.append("--tor")
    elif incognito and engine == "chromium":
        cmd.append("--incognito")
    elif incognito and engine == "firefox":
        cmd.append("-private-window")
    # Tor Browser itself never gets an incognito/tor flag - it's private by default
 
    if url:
        cmd.append(url)
 
    return cmd
 
 
def launch_tab(master, name: str, url: str, incognito: bool, tor: bool = False):
    """Launch `name` at `url`. If the browser isn't found and winget is
    available, offers to install it, then launches once install finishes.
    `master` is any Tk widget used to anchor dialogs (e.g. the root window)."""
    path = find_browser_path(name)
 
    if path:
        _spawn(name, url, incognito, tor)
        return
 
    if not winget_available():
        messagebox.showerror(
            "Browser not found",
            f"Couldn't find {name} installed on this system, and winget "
            f"isn't available to auto-install it.\n"
            f"Install {name} manually, or make sure it's on your PATH.",
        )
        return
 
    if not messagebox.askyesno(
        "Browser not found",
        f"{name} isn't installed. Install it now via winget and then launch it?",
    ):
        return
 
    progress = tk.Toplevel(master)
    progress.title("Installing…")
    progress.geometry("360x100")
    progress.resizable(False, False)
    progress.transient(master)
    progress.grab_set()
    ttk.Label(progress, text=f"Installing {name} via winget…", padding=12).pack()
    bar = ttk.Progressbar(progress, mode="indeterminate", length=300)
    bar.pack(pady=8)
    bar.start(12)
 
    result_holder = {}
 
    def worker():
        success, message = install_via_winget(name)
        result_holder["success"] = success
        result_holder["message"] = message
 
    thread = threading.Thread(target=worker, daemon=True)
    thread.start()
 
    def poll():
        if thread.is_alive():
            master.after(200, poll)
            return
        bar.stop()
        progress.grab_release()
        progress.destroy()
 
        if not result_holder.get("success"):
            messagebox.showerror(
                "Install failed",
                f"Couldn't install {name} via winget:\n{result_holder.get('message')}",
            )
            return
 
        new_path = find_browser_path(name)
        if not new_path:
            messagebox.showerror(
                "Installed, but not found",
                f"{name} was installed but couldn't be located afterward. "
                f"You may need to restart Simpler Browser.",
            )
            return
 
        _spawn(name, url, incognito, tor)
 
    master.after(200, poll)
 
 
def _spawn(name: str, url: str, incognito: bool, tor: bool):
    cmd = build_command(name, url, incognito, tor)
    if cmd is None:
        messagebox.showerror(
            "Browser not found",
            f"Couldn't find {name} installed on this system.\n"
            f"Make sure it's installed and on your PATH.",
        )
        return False
    try:
        subprocess.Popen(cmd)
        return True
    except Exception as exc:
        messagebox.showerror("Launch failed", f"Couldn't launch {name}:\n{exc}")
        return False
 
 
