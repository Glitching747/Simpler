class TabRow(ttk.Frame):
    """One row = one configured tab: browser choice, URL, incognito toggle."""
 
    def __init__(self, parent, remove_callback, index, browser="Firefox", url=""):
        super().__init__(parent, padding=6)
        self.remove_callback = remove_callback
 
        ttk.Label(self, text=f"Tab {index}", width=7).grid(row=0, column=0, padx=4)
 
        self.browser_var = tk.StringVar(value=browser)
        browser_menu = ttk.Combobox(
            self, textvariable=self.browser_var, values=BROWSER_NAMES,
            state="readonly", width=18,
        )
        browser_menu.grid(row=0, column=1, padx=4)
        browser_menu.bind("<<ComboboxSelected>>", self._on_browser_change)
 
        self.url_var = tk.StringVar(value=url)
        url_entry = ttk.Entry(self, textvariable=self.url_var, width=38)
        url_entry.grid(row=0, column=2, padx=4)
 
        self.incognito_var = tk.BooleanVar(value=False)
        self.incognito_check = ttk.Checkbutton(
            self, text="Incognito", variable=self.incognito_var,
        )
        self.incognito_check.grid(row=0, column=3, padx=4)
 
        self.tor_var = tk.BooleanVar(value=False)
        self.tor_check = ttk.Checkbutton(
            self, text="Tor (Brave)", variable=self.tor_var,
            command=self._on_tor_toggle,
        )
        self.tor_check.grid(row=0, column=4, padx=4)
 
        ttk.Button(self, text="Launch", command=self.launch).grid(row=0, column=5, padx=4)
        ttk.Button(self, text="✕", width=3, command=self._remove).grid(row=0, column=6, padx=4)
 
        self._on_browser_change()
 
    def _on_browser_change(self, event=None):
        # Tor Browser and I2P are always private/have no incognito mode --
        # disable and clear the incognito toggle for them
        if self.browser_var.get() in ("Tor Browser", "I2P"):
            self.incognito_var.set(False)
            self.incognito_check.state(["disabled"])
        else:
            self.incognito_check.state(["!disabled"])
 
        # The "Tor (Brave)" box only makes sense when Brave is selected
        if self.browser_var.get() == "Brave":
            self.tor_check.state(["!disabled"])
        else:
            self.tor_var.set(False)
            self.tor_check.state(["disabled"])
        self._on_tor_toggle()
 
    def _on_tor_toggle(self):
        # Tor-in-Brave is already a private window, so incognito is redundant
        # and gets disabled while it's checked.
        if self.tor_var.get():
            self.incognito_var.set(False)
            self.incognito_check.state(["disabled"])
        elif self.browser_var.get() not in ("Tor Browser", "I2P"):
            self.incognito_check.state(["!disabled"])
 
    def _remove(self):
        self.remove_callback(self)
 
    def launch(self):
        name = self.browser_var.get()
        url = self.url_var.get().strip()
        incognito = self.incognito_var.get()
        tor = self.tor_var.get()
        launch_tab(self.winfo_toplevel(), name, url, incognito, tor)
 
    def get_config(self):
        return self.browser_var.get(), self.url_var.get().strip(), self.incognito_var.get(), self.tor_var.get()
 
 
class SimplerBrowserApp(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("Simpler Browser")
        self.geometry("780x420")
        self.minsize(700, 320)
 
        header = ttk.Frame(self, padding=10)
        header.pack(fill="x")
        ttk.Label(
            header, text="Simpler Browser", font=("Segoe UI", 16, "bold")
        ).pack(side="left")
        ttk.Label(
            header,
            text="  — do it simpler, do it better",
            font=("Segoe UI", 10),
        ).pack(side="left")
 
        # Scrollable area for tab rows
        container = ttk.Frame(self)
        container.pack(fill="both", expand=True, padx=10, pady=6)
 
        canvas = tk.Canvas(container, highlightthickness=0)
        scrollbar = ttk.Scrollbar(container, orient="vertical", command=canvas.yview)
        self.rows_frame = ttk.Frame(canvas)
 
        self.rows_frame.bind(
            "<Configure>", lambda e: canvas.configure(scrollregion=canvas.bbox("all"))
        )
        canvas.create_window((0, 0), window=self.rows_frame, anchor="nw")
        canvas.configure(yscrollcommand=scrollbar.set)
 
        canvas.pack(side="left", fill="both", expand=True)
        scrollbar.pack(side="right", fill="y")
 
        self.rows = []
 
        # Bottom control bar
        controls = ttk.Frame(self, padding=10)
        controls.pack(fill="x")
 
        ttk.Button(controls, text="+ Add Tab", command=self.add_row).pack(side="left")
        ttk.Button(
            controls, text="Reset to Default (Brave: New Tab)",
            command=self.load_default,
        ).pack(side="left", padx=8)
        ttk.Button(
            controls, text="Launch All", command=self.launch_all,
        ).pack(side="right")
 
        # Start with the default pre-loaded so it's useful immediately
        self.load_default()
 
    def add_row(self, browser="Firefox", url=""):
        index = len(self.rows) + 1
        row = TabRow(self.rows_frame, self.remove_row, index, browser=browser, url=url)
        row.pack(fill="x", pady=2)
        self.rows.append(row)
 
    def remove_row(self, row):
        row.destroy()
        self.rows.remove(row)
        self._renumber()
 
    def _renumber(self):
        for i, row in enumerate(self.rows, start=1):
            row.grid_slaves(row=0, column=0)[0].config(text=f"Tab {i}")
 
    def clear_rows(self):
        for row in list(self.rows):
            row.destroy()
        self.rows.clear()
 
    def load_default(self):
        self.clear_rows()
        self.add_row("Brave", "")
 
    def launch_all(self):
        if not self.rows:
            messagebox.showinfo("Nothing to launch", "Add at least one tab first.")
            return
        for row in self.rows:
            name, url, incognito, tor = row.get_config()
            launch_tab(self, name, url, incognito, tor)
 
 
if __name__ == "__main__":
    app = SimplerBrowserApp()
    app.mainloop()
